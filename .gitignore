.venv/
__pycache__/
*.pyc
.pytest_cache/
strata.db
.DS_Store

# Coverage output. `.coverage` is a SQLite file recording which lines one run
# executed on one machine, so committing it puts a binary that changes on every
# run into a history reviewers read. It was committed once by accident and is
# deleted here; the number belongs in prose with the command beside it, not in
# a tracked artefact nobody can diff.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets. Never commit. This repo goes public with history intact (task T24),
# so anything committed here cannot be taken back by a later deletion.
.env
.env.*
!.env.example

# Generated by scripts/publish_docs.py from docs/. One source of truth per
# document: committing this copy would give every page two homes, and this
# project has spent a day on what happens when one is edited and the other is
# not. Rebuilt on every deploy.
deploy/site/docs/
