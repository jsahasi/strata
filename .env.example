# Strata environment. Copy to .env and fill in. .env is gitignored.
#
# Deterministic components -- ingestion, citation verification, version diffing --
# need none of these and run fully offline. That is what `make test` exercises.
# Only the model-backed components (obligation extraction, materiality) need a key.

# Model provider for extraction and materiality interpretation.
ANTHROPIC_API_KEY=

# Outbound mail, used only by the user-research outreach script (task T1).
# Not required by the application. Leave blank if you send by hand.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
