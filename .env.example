# Strata environment. Copy to .env and fill in what you need. .env is gitignored.
#
# NOTHING HERE IS REQUIRED TO RUN OR TEST. `make test` passes with this file
# absent: the deterministic half of the product -- ingestion, version diffing,
# citation verification, the audit chain -- needs no key and reaches no network,
# and that is deliberate rather than incidental. `make run` serves every screen
# with none of these set. What you lose is stated beside each one.
#
# app/config.py loads this file into the process at startup, before anything
# reads it. THE REAL ENVIRONMENT ALWAYS WINS: a variable already exported, or set
# in deploy/compose.yml, is never overwritten by this file. A container is a
# deliberate act; a file on disk is a default.
#
# Every name below is read somewhere in app/ or scripts/, derived from the code
# rather than remembered. An example file listing variables nothing reads is
# worse than none, because it sends somebody hunting for the effect of setting
# one.


# --------------------------------------------------------------- the database

# A SQLAlchemy URL, NOT a path. This is the one to get right: set a path here and
# SQLAlchemy will not complain -- it will quietly open ./strata.db relative to
# the working directory, and you will spend an hour wondering where your rows
# went. Note the four slashes for an absolute path.
#   STRATA_DATABASE_URL=sqlite:////var/lib/strata/strata.db
# Unset, it is sqlite:///strata.db in the current directory.
STRATA_DATABASE_URL=


# ------------------------------------------------------------------- the model

# Without it every model-backed path ANNOUNCES that it is off and every screen
# still serves. That is the designed behaviour, not a degradation to hide.
# Read by app/chat/agent.py (the assistant) and app/interpretation/propose.py
# (proposing claims from a diff). Neither sits on the verification path: a claim
# still has to survive its citation whatever produced it.
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------- mail

# Invitations and provisioning notices. With no relay configured the product says
# so and hands the administrator the link to pass on by hand. It never reports a
# mail as sent that was not.
# Port 465 means implicit TLS; 587, the default, means STARTTLS. USERNAME and
# PASSWORD go together: one without the other is refused rather than guessed at.
STRATA_SMTP_HOST=
STRATA_SMTP_PORT=
STRATA_SMTP_USERNAME=
STRATA_SMTP_PASSWORD=
STRATA_MAIL_FROM=


# --------------------------------------------------------------------- tenancy

# Which company a request belongs to when no session answers it, and what to call
# it on screen. The signed-in person's company always wins over both.
STRATA_COMPANY_ID=
STRATA_COMPANY_NAME=


# --------------------------------------------------------------- what it refuses

# The confidence floor, in basis points, below which a claim escalates rather
# than asserts (ADR-006). Lower it and more gets asserted. That is the trade, and
# it is configuration on purpose so nobody edits a constant to make a demo pass.
STRATA_MIN_CONFIDENCE_BP=

# Segregation of duties. Unset means enforced. The demo may waive it, and the
# waiver writes itself into the audit chain rather than passing silently
# (ADR-019). Do not set this on anything real.
#   STRATA_APPROVAL_MODE=demo
STRATA_APPROVAL_MODE=

# Invitations: whether they may be sent at all, and whether every one needs an
# administrator's approval regardless of the sender's email domain.
STRATA_INVITES_ENABLED=
STRATA_INVITES_NEED_APPROVAL=

# The login page prints the demonstration accounts and their shared password.
# Right for a workspace holding invented data and public record, wrong for
# anything else. Set to 0 on any deployment holding a customer's documents.
STRATA_DEMO_ACCOUNTS=

# The session cookie is marked Secure, so it is dropped over plain http. Set to 0
# ONLY for a loopback development server, never anywhere a browser reaches over a
# network.
STRATA_COOKIE_SECURE=


# --------------------------------------------------------- integration secrets

# A source registered in Integrations stores the NAME of the variable holding its
# key, never the key itself. So the registry can be read, backed up or
# screenshotted without handing anything over, and the secret lives here with
# everything else. Name them however you like; the registry records which name it
# was told.
#   STRATA_SOURCE_ACME_KEY=


# ------------------------------------------------------------------- outreach

# NOT USED BY THE APPLICATION. These belong to the user-research outreach script
# in the working notes, which sends mail from a personal mailbox. The product
# sends through the SMTP settings above and never touches these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
